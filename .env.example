# =============================================================================
# Ledcenter.hu — kornyezeti valtozok sablonja
# =============================================================================
# A tenyleges ertekeket NE tedd ide. Hasznald a Railway env-eket vagy a .env.local-t.
# .env soha NEM kerul commit-ba (lasd .gitignore).

# --- Database ---
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa_dev

# --- Redis (BullMQ + cache + event-bus + idempotency lock) ---
REDIS_URL=redis://localhost:6379

# --- Medusa secrets ---
JWT_SECRET=change-me-min-64-chars-random
COOKIE_SECRET=change-me-min-64-chars-random
STORE_CORS=http://localhost:8000,http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:7001
AUTH_CORS=http://localhost:8000,http://localhost:9000

# --- Storefront ---
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
REVALIDATE_SECRET=change-me-random-token

# --- Barion (sandbox) ---
BARION_POSKEY_SANDBOX=
BARION_POSKEY_LIVE=
BARION_PIXEL_ID=
BARION_ENVIRONMENT=test
BARION_PAYEE=

# --- Szamlazz.hu ---
SZAMLAZZ_AGENT_KEY=
SZAMLAZZ_INVOICE_PREFIX=

# --- NAV (Szamlazz kezeli, csak monitorozas) ---
NAV_TECHNIKAI_USER=
NAV_TECHNIKAI_PASSWORD=

# --- Resend (email) ---
RESEND_API_KEY=
RESEND_FROM=info@ledcenter.hu

# --- Meilisearch ---
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=
MEILISEARCH_SEARCH_KEY=

# --- Cloudflare R2 (image storage) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=ledcenter-media
R2_PUBLIC_URL=https://media.ledcenter.hu

# --- Bunny.net Optimizer ---
BUNNY_OPTIMIZER_PULL_ZONE=

# --- Sentry (errors) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- PostHog (analytics) ---
POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# --- Better Stack (uptime + log) ---
BETTER_STACK_TOKEN=

# --- Anthropic (admin AI tools T5.4, T5.5) ---
ANTHROPIC_API_KEY=

# --- ShopRenter (egyszer hasznalt migracio T8) ---
SHOPRENTER_CLIENT_ID=
SHOPRENTER_CLIENT_SECRET=
SHOPRENTER_SHOP_ID=

# --- Shipping ---
FOXPOST_API_KEY=
MPL_API_USERNAME=
MPL_API_PASSWORD=
GLS_API_USERNAME=
GLS_API_PASSWORD=

# --- Cloudflare (DNS + WAF) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
